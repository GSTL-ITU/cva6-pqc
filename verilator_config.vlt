// common waiver rules for verilator

`verilator_config

// waving these warnings since they are in vendor or core_apu
lint_off -rule STMTDLY -file "*/corev_apu/*"
lint_off -rule WIDTHEXPAND -file "*/common/local/util/sram.sv"
lint_off -rule WIDTHTRUNC -file "*/core/include/std_cache_pkg.sv"
lint_off -file "*/corev_apu/*"
lint_off -file "*/vendor/*"

lint_off -rule WIDTHEXPAND -file "*/core/cache_subsystem/axi_adapter.sv"
lint_off -rule WIDTHEXPAND -file "*/core/axi_shim.sv"

// P2
lint_off -rule WIDTHEXPAND -file "*/core/issue_read_operands.sv"
lint_off -rule WIDTHEXPAND -file "*/core/ariane_regfile_ff.sv"
lint_off -rule SELRANGE -file "*/core/commit_stage.sv"


// Uncomment to trace these signals only (might be used for Hamming Weight calculations in the future)
//tracing_off -scope "*"
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.ex_stage_i.alu_wrapper_i.alu_i.operand_a" 
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.ex_stage_i.alu_wrapper_i.alu_i.operand_b"
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.ex_stage_i.alu_wrapper_i.alu_i.result_o"  
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.issue_stage_i.i_issue_read_operands.gen_asic_regfile.i_ariane_regfile.mem"
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.issue_stage_i.i_issue_read_operands.gen_fpga_regfile.i_ariane_regfile_fpga.mem"
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.ex_stage_i.lsu_i.load_result_o"
//tracing_on -scope "ariane_testharness.i_ariane.i_cva6.ex_stage_i.lsu_i.store_result_o"